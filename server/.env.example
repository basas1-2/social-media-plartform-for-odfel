# Server Port
PORT=5000

# MongoDB Atlas connection string
# Replace <password> with your Atlas password and <dbname> with your database name
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codfel-social-media?retryWrites=true&w=majority

# JWT secret
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Client URL for CORS
CLIENT_URL=http://localhost:3000

